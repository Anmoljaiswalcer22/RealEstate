# Copy this file to .env and fill in the values. NEVER commit .env to GitHub.

PORT=3000
NODE_ENV=development

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/estate?retryWrites=true&w=majority

# Two DIFFERENT long random strings. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string

# Token lifetimes
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Where the React app runs (used for CORS)
CLIENT_URL=http://localhost:5173

# Optional: folder for uploaded images (default: server/uploads)
# UPLOAD_DIR=

# Optional but recommended: Firebase service account JSON on ONE line.
# When set, /api/auth/google verifies the Firebase ID token instead of trusting the email.
# Firebase console -> Project settings -> Service accounts -> Generate new private key
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...", ...}
